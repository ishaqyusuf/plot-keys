{
  "name": "plotkeys",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "brand:logos": "node ./scripts/generate-plotkeys-logo-assets.mjs",
    "build": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode prod -- turbo build",
    "db:docker:down": "docker compose -f docker-compose.yml down",
    "db:docker:up": "bun run dev:services:local",
    "db:down": "bun run db:docker:down",
    "db:generate": "bun scripts/db-command.ts generate",
    "db:generate:prod": "bun scripts/db-command.ts generate --prod",
    "db:generate:remote": "bun scripts/db-command.ts generate --remote",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "bun scripts/db-command.ts migrate",
    "db:migrate:prod": "bun scripts/db-command.ts migrate --prod",
    "db:migrate:remote": "bun scripts/db-command.ts migrate --remote",
    "db:push": "bun scripts/db-command.ts push",
    "db:push:prod": "bun scripts/db-command.ts push --prod",
    "db:push:remote": "bun scripts/db-command.ts push --remote",
    "db:shell": "bun scripts/db-command.ts shell",
    "db:shell:local": "bun run db:shell",
    "db:shell:prod": "bun scripts/db-command.ts shell --prod",
    "db:shell:remote": "bun scripts/db-command.ts shell --remote",
    "db:start": "bun run dev:services:local",
    "db:studio": "bun scripts/db-command.ts studio",
    "db:studio:prod": "bun scripts/db-command.ts studio --prod",
    "db:studio:remote": "bun scripts/db-command.ts studio --remote",
    "db:drizzle:studio": "bun scripts/db-command.ts drizzle-studio",
    "db:up": "bun run db:start",
    "email:test": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode local -- bun scripts/send-test-email.mjs",
    "kill:ports": "bun --env-file=/dev/null ../local-infra-kit/bin/kill-ports.ts --profile plotkeys",
    "dev:prepare": "bun run kill:ports && bun run dev:services",
    "dev:services": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services",
    "dev:services:local": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services --mode local",
    "dev:services:local-db": "bun run dev:services:local",
    "dev": "bun --env-file=/dev/null scripts/local-infra-command.ts dev",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@trigger.dev/build": "3.3.14",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
