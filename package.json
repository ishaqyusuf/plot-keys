{
  "name": "plotkeys",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "brand:logos": "node ./scripts/generate-plotkeys-logo-assets.mjs",
    "build": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode prod -- turbo build",
    "build:platform": "turbo build",
    "db:docker:down": "docker compose -f docker-compose.yml down",
    "db:docker:up": "bun run dev:services:local",
    "db:down": "bun run db:docker:down",
    "db:generate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts generate --profile plotkeys",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts migrate --profile plotkeys",
    "db:pull": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts pull --profile plotkeys",
    "db:push": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts push --profile plotkeys",
    "db:shell": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts shell --profile plotkeys",
    "db:start": "bun run dev:services:local",
    "db:studio": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts studio --profile plotkeys",
    "db:drizzle:studio": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts drizzle-studio --profile plotkeys",
    "db:up": "bun run db:start",
    "email:test": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode local -- bun scripts/send-test-email.mjs",
    "kill:ports": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode local -- bun --env-file=/dev/null ../local-infra-kit/bin/kill-ports.ts --profile plotkeys --mode local",
    "dev:prepare": "bun run kill:ports && bun run dev:services",
    "dev:services": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services",
    "dev:services:local": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services --mode local",
    "dev:services:local-db": "bun run dev:services:local",
    "dev": "bun --env-file=/dev/null scripts/local-infra-command.ts dev",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@trigger.dev/build": "3.3.14",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
