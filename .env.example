# Plot Keys root environment contract
# .env.local         local development
# .env.remote.local  remote development overrides loaded over .env.local
# .env.prod          local production-mode commands
# Hosted deployments use platform-injected environment variables.

## Runtime profile
APP_ENV=

## Database
# Local default: postgresql://postgres:postgres@127.0.0.1:55432/plotkeys
DATABASE_URL=

## Application ports
WEBSITE_PORT=3900
SITE_PORT=3900
DASHBOARD_PORT=3901
API_PORT=3902
TENANT_SITE_PORT=3903
EMAIL_PORT=3904
SANDBOX_PORT=3909
WEBSITE_PROD_PORT=3905
DASHBOARD_PROD_PORT=3906
API_PROD_PORT=3907
TENANT_SITE_PROD_PORT=3908

## Application URLs
# Portless defaults use plotkeys.localhost, app-plotkeys.localhost,
# api-plotkeys.localhost, tenant-plotkeys.localhost, and
# sandbox-plotkeys.localhost.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_DASHBOARD_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TENANT_SITE_URL=
NEXT_PUBLIC_SANDBOX_URL=
DASHBOARD_APP_URL=
SITE_PUBLIC_URL=
DASHBOARD_PUBLIC_URL=
API_PUBLIC_URL=
TENANT_SITE_PUBLIC_URL=
TENANT_SITE_URL=
SANDBOX_PUBLIC_URL=

## Application domains and local proxying
SITE_ROOT_DOMAIN=plotkeys.com
DASHBOARD_ROOT_DOMAIN=app.plotkeys.com
API_ROOT_DOMAIN=api.plotkeys.com
TENANT_SITE_ROOT_DOMAIN=plotkeys.com
SANDBOX_ROOT_DOMAIN=sandbox.plotkeys.com
SITE_PORTLESS_ROOT_DOMAIN=plotkeys.localhost
DASHBOARD_PORTLESS_ROOT_DOMAIN=app-plotkeys.localhost
API_PORTLESS_ROOT_DOMAIN=api-plotkeys.localhost
TENANT_SITE_PORTLESS_ROOT_DOMAIN=tenant-plotkeys.localhost
SANDBOX_PORTLESS_ROOT_DOMAIN=sandbox-plotkeys.localhost
DASHBOARD_TENANT_ROOT_DOMAIN=
PLOTKEYS_ROOT_DOMAIN=plotkeys.com
PLOTKEYS_LOCAL_ROOT_DOMAIN=plotkeys.localhost
PLOTKEYS_LOCAL_DASHBOARD_PROXY_TARGET=http://127.0.0.1:3901
PLOTKEYS_DASHBOARD_APP_PORT=3901
TENANT_URL_PROJECT_SLUG=
NEXT_PUBLIC_TENANT_URL_PROJECT_SLUG=

## Public website mode
EARLY_ACCESS=
PLOTKEYS_PUBLIC_SITE_MODE=

## Auth
BETTER_AUTH_SECRET=
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_TRUSTED_ORIGINS=

## Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Email
EMAIL_DELIVERY_MODE=
EMAIL_FROM=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_QA_DOMAIN_ROUTES=
RESEND_API_KEY=
TEST_EMAIL=

## WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

## AI
ANTHROPIC_API_KEY=

## Billing
PAYSTACK_SECRET_KEY=

## Storage and public images
ASSET_STORAGE_PROVIDER=vercel_blob
BLOB_READ_WRITE_TOKEN=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

## QA and maintenance
