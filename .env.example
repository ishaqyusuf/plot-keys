# Plot Keys root environment contract
# .env.local         local development
# .env.remote.local  remote development overrides loaded over .env.local
# .env.prod          production

## Database
# Local default: postgresql://postgres:postgres@127.0.0.1:55432/plotkeys
DATABASE_URL=

## Local app ports
WEBSITE_PORT=3900
DASHBOARD_PORT=3901
API_PORT=3902
TENANT_SITE_PORT=3903
EMAIL_PORT=3904

## Local URLs
# Portless defaults use plotkeys.localhost, app-plotkeys.localhost,
# api-plotkeys.localhost, and tenant-plotkeys.localhost.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TENANT_SITE_URL=
DASHBOARD_APP_URL=

## Auth
BETTER_AUTH_SECRET=
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_TRUSTED_ORIGINS=

## Email
EMAIL_DELIVERY_MODE=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
TEST_EMAIL=

## AI
ANTHROPIC_API_KEY=

## Storage and public images
ASSET_STORAGE_PROVIDER=vercel_blob
BLOB_READ_WRITE_TOKEN=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

## Jobs
TRIGGER_SECRET_KEY=

## Vercel
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
