{
  "name": "@plotkeys/tenant-site",
  "private": true,
  "scripts": {
    "build": "bun next build --turbopack",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "bun ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode local -- PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${TENANT_SITE_PORT:-3903}} PORTLESS_WILDCARD=1 portless tenant-plotkeys next dev --turbopack",
    "dev:prod": "bun ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- next dev --turbopack -p ${TENANT_SITE_PROD_PORT:-3908}",
    "lint": "biome check .",
    "start": "bun ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- next start -p ${TENANT_SITE_PORT:-3903}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plotkeys/auth": "workspace:*",
    "@plotkeys/chat-bot": "workspace:*",
    "@plotkeys/db": "workspace:*",
    "@plotkeys/jobs": "workspace:*",
    "@plotkeys/notifications-react": "workspace:*",
    "@plotkeys/plot-renderer": "workspace:*",
    "@plotkeys/section-registry": "workspace:*",
    "@plotkeys/ui": "workspace:*",
    "@plotkeys/utils": "workspace:*",
    "next": "^16.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@plotkeys/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0"
  }
}
