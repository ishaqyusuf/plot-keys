{
  "name": "@plotkeys/dashboard",
  "private": true,
  "scripts": {
    "build": "bun next build --turbopack",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys -- PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${DASHBOARD_PORT:-3901}} PORTLESS_WILDCARD=1 portless app-plotkeys next dev --turbopack",
    "dev:prod": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- next dev --turbopack -p ${DASHBOARD_PROD_PORT:-3906}",
    "lint": "biome check .",
    "start": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- next start -p ${DASHBOARD_PORT:-3901}",
    "with-env": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@plotkeys/api": "workspace:*",
    "@plotkeys/app-store": "workspace:*",
    "@plotkeys/auth": "workspace:*",
    "@plotkeys/db": "workspace:*",
    "@plotkeys/jobs": "workspace:*",
    "@plotkeys/notifications": "workspace:*",
    "@plotkeys/notifications-react": "workspace:*",
    "@plotkeys/platform-integrations": "workspace:*",
    "@plotkeys/section-registry": "workspace:*",
    "@plotkeys/site-nav": "workspace:*",
    "@plotkeys/ui": "workspace:*",
    "@plotkeys/utils": "workspace:*",
    "@plotkeys/website-builder": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@trpc/tanstack-react-query": "^11.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "little-date": "^1.2.1",
    "next": "^16.1.5",
    "nuqs": "^2.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.3.2",
    "server-only": "^0.0.1",
    "superjson": "^2.2.2",
    "zod": "^3.23.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@plotkeys/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0"
  }
}
