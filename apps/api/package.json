{
  "name": "@plotkeys/api",
  "private": true,
  "type": "module",
  "exports": {
    "./asset-service": "./src/lib/asset-service.ts",
    "./context": "./src/context.ts",
    "./filters": "./src/db/queries/filters/index.ts",
    "./public-image-providers": "./src/lib/public-image-providers/index.ts",
    "./router": "./src/routers/_app.ts",
    "./schemas/auth": "./src/schemas/auth.schema.ts",
    "./schemas/workspace": "./src/schemas/workspace.schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "bun ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode local -- PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${API_PORT:-3902}} PORTLESS_WILDCARD=1 portless api-plotkeys bun --watch src/index.ts",
    "dev:prod": "bun ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- PORT=${API_PROD_PORT:-3907} bun --watch src/index.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@hono/node-server": "^1.13.0",
    "@plotkeys/auth": "workspace:*",
    "@plotkeys/chat-bot": "workspace:*",
    "@plotkeys/db": "workspace:*",
    "@plotkeys/jobs": "workspace:*",
    "@plotkeys/notifications": "workspace:*",
    "@plotkeys/platform-integrations": "workspace:*",
    "@plotkeys/section-registry": "workspace:*",
    "@plotkeys/utils": "workspace:*",
    "@trpc/server": "^11.0.0",
    "hono": "^4.0.0",
    "superjson": "^2.2.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@plotkeys/tsconfig": "workspace:*",
    "@types/node": "^22.0.0"
  }
}
