{
  "name": "@plotkeys/website",
  "private": true,
  "scripts": {
    "build": "bun next build --turbopack",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys -- PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${WEBSITE_PORT:-3900}} PORTLESS_WILDCARD=1 portless plotkeys next dev --turbopack",
    "dev:prod": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- next dev --turbopack -p ${WEBSITE_PROD_PORT:-3905}",
    "lint": "biome check .",
    "start": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile plotkeys --mode prod -- next start -p ${WEBSITE_PORT:-3900}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plotkeys/db": "workspace:*",
    "@plotkeys/notifications-react": "workspace:*",
    "@plotkeys/utils": "workspace:*",
    "@plotkeys/ui": "workspace:*",
    "lucide-react": "^0.577.0",
    "next": "^16.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@plotkeys/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0"
  }
}
