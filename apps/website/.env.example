# Browser-safe client variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public auth handoff
DASHBOARD_APP_URL=https://app.plotkeys.com
NEXT_PUBLIC_DASHBOARD_APP_URL=https://app.plotkeys.com
# Portless local dashboard URL: http://app.plotkeys.localhost:1355

# Server-only public website gate.
# Use EARLY_ACCESS=true to show the early access page at `/`.
EARLY_ACCESS=true
# Legacy mode override: "early-access" or "landing"
PLOTKEYS_PUBLIC_SITE_MODE=early-access
